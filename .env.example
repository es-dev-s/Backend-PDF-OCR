# HTTP
HTTP_ADDR=127.0.0.1:8001
# Railway/Fly set PORT. The API binds 0.0.0.0:$PORT when PORT is present.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fill these with your managed endpoints.
DATABASE_URL=postgres://user:password@localhost:5432/ocr?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Local disk for now. Swap STORAGE_DRIVER later for object storage.
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads

# Uploads / workers
MAX_UPLOAD_BYTES=52428800
MAX_SOURCES=4
WORKER_CONCURRENCY=16

# OCR Engine (title extraction). Default local Engine from API.md.
ENGINE_BASE_URL=http://127.0.0.1:8000
HEARTBEAT_SECONDS=2
SHUTDOWN_TIMEOUT_SECONDS=20

# HTTP
# Local only. On Railway do not set HTTP_ADDR; PORT is injected.
HTTP_ADDR=127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://web-pdf-ocr-production.up.railway.app

# Fill these with your managed endpoints.
DATABASE_URL=postgres://user:password@localhost:5432/ocr?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Object storage. If R2 keys are set, the API always uses R2 — even if
# STORAGE_DRIVER is local or unset. Hosted (PORT set) refuses local disk.
STORAGE_DRIVER=r2
STORAGE_DIR=./data/uploads

# Cloudflare R2. Required in production.
# R2_ENDPOINT can be omitted; it is derived from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ocr-doc-bucket
R2_ENDPOINT=
R2_PREFIX=ocr/v1

# Uploads / workers
MAX_UPLOAD_BYTES=52428800
MAX_SOURCES=4
WORKER_CONCURRENCY=2
# Set this on the Go API Railway service (~70% of that service's plan).
# Example for a 24GB plan: 16GiB. Leave unset to use 70% of the cgroup limit.
GOMEMLIMIT=16GiB

# OCR Engine (title extraction).
ENGINE_BASE_URL=https://text-extracter-v2-production.up.railway.app
# First admin. Created once if the email does not already exist.
AUTH_ADMIN_EMAIL=admin@ocr.local
AUTH_ADMIN_PASSWORD=change-me-now
AUTH_ADMIN_NAME=Admin

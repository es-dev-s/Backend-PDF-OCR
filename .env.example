# HTTP
# Local only. On Railway do not set HTTP_ADDR; PORT is injected.
HTTP_ADDR=127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://web-pdf-ocr-production.up.railway.app

# Fill these with your managed endpoints.
DATABASE_URL=postgres://user:password@localhost:5432/ocr?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Local disk for now. Swap STORAGE_DRIVER later for object storage.
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads

# Cloudflare R2 (set STORAGE_DRIVER=r2 to use).
# R2_ENDPOINT can be omitted; it is derived from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PREFIX=ocr/v1

# Uploads / workers
MAX_UPLOAD_BYTES=52428800
MAX_SOURCES=4
WORKER_CONCURRENCY=16

# OCR Engine (title extraction).
ENGINE_BASE_URL=https://text-extracter-v2-production.up.railway.app
HEARTBEAT_SECONDS=2
SHUTDOWN_TIMEOUT_SECONDS=20
